# Bash scripts must keep LF even on Windows clones (core.autocrlf would break them).
* text=auto eol=lf

# Windows-native files
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf

*.png  binary
*.jpg  binary
*.7z   binary
*.zst  binary
